{
  "base_url": "https://damaplus.online/",
  "headless": true,
  "poll_interval_seconds": 0.3,
  "action_delay_ms": [
    0,
    0
  ],
  "difficulty_weights": {
    "mistake_rate": 0.0
  },
  "hard_search_depth": 0,
  "accounts": [
    {
      "id": "disclosed-xo-bot-1",
      "storage_state": "sessions/disclosed-xo-bot-1.storage.json",
      "variant": "xo"
    }
  ],
  "selectors": {
    "authenticated": "#playerApp:not(.hidden)",
    "logged_out": "#authLanding:not(.hidden)",
    "xo_matchmaking": "[data-find-player='xo'], [data-start='xo']",
    "match_stake_modal": "#matchStakeModal",
    "match_stake_choices": "#matchStakeChoices",
    "start_notice": "#xoStartNotice",
    "turn_indicator": "#xoStatus",
    "cell": "#xoBoard > .xo-cell",
    "return_home": ".nav-item[data-view='home']"
  },
  "attributes": {
    "ui_mode": "damaplus"
  }
}
