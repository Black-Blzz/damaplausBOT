{
  "base_url": "https://damaplus.online/",
  "headless": true,
  "poll_interval_seconds": 2.0,
  "action_delay_ms": [350, 900],
  "difficulty_weights": {
    "beginner": 1.0
  },
  "hard_search_depth": 1,
  "accounts": [
    {
      "id": "damaplus-tankegna-bot-1",
      "storage_state": "sessions/damaplus-tankegna-bot-1.storage.json",
      "variant": "tankegna"
    }
  ],
  "selectors": {
    "authenticated": "#playerApp:not(.hidden)",
    "logged_out": "#authLanding:not(.hidden)",
    "tankegna_matchmaking": "[data-find-player='dama-tankegna'], [data-start='dama-tankegna']",
    "match_stake_modal": "#matchStakeModal",
    "match_stake_choices": "#matchStakeChoices",
    "match_found": "#damaBoard",
    "board_square": "#damaBoard > .square",
    "piece": ".piece",
    "turn_indicator": "#damaStatus",
    "game_over": "#damaStatus",
    "return_home": ".nav-item[data-view='home']"
  },
  "attributes": {
    "square": "data-square",
    "piece_color": "data-piece-color",
    "piece_king": "data-is-king",
    "bot_color": "data-player-color",
    "turn": "data-player",
    "result": "data-result",
    "ui_mode": "damaplus"
  }
}
